  "editor.tokenColorCustomizations": {
    "comments":  "#A87828",
    "keywords":  "#C5913F",
    "strings":   "#C5913F",
    "functions": "#F3BA63",
    "numbers":   "#727D6F",
    "variables": "#E0E0E0",
    "types":     "#A43D3E",
    "textMateRules": [
      {
        "scope": ["keyword", "storage", "storage.type", "storage.modifier"],
        "settings": { "foreground": "#C5913F" }
      },
      {
        "scope": ["string", "string.quoted", "string.regexp"],
        "settings": { "foreground": "#C5913F" }
      },
      {
        "scope": ["entity.name.function", "support.function", "meta.function-call"],
        "settings": { "foreground": "#F3BA63" }
      },
      {
        "scope": ["variable", "variable.other", "variable.parameter"],
        "settings": { "foreground": "#E0E0E0" }
      },
      {
        "scope": ["constant", "constant.numeric", "constant.language"],
        "settings": { "foreground": "#727D6F" }
      },
      {
        "scope": ["entity.name.type", "support.type", "support.class"],
        "settings": { "foreground": "#A43D3E" }
      },
      {
        "scope": ["comment", "punctuation.definition.comment"],
        "settings": { "foreground": "#A87828", "fontStyle": "italic" }
      }
    ]
  }
