    "input.foreground":                   "{{foreground}}",
    "input.border":                       "{{color8}}",
    "list.activeSelectionBackground":     "{{color4}}44",
    "list.hoverBackground":               "{{color0}}",
    "badge.background":                   "{{color6}}",
    "badge.foreground":                   "{{background}}"
  },
  "editor.tokenColorCustomizations": {
    "comments":  "{{color8}}",
    "keywords":  "{{color6}}",
    "strings":   "{{color14}}",
    "functions": "{{color7}}",
    "numbers":   "{{color11}}",
    "variables": "#E0E0E0",
    "types":     "{{color13}}",
    "textMateRules": [
      {
        "scope": ["keyword", "storage", "storage.type", "storage.modifier"],
        "settings": { "foreground": "{{color6}}" }
      },
      {
        "scope": ["string", "string.quoted", "string.regexp"],
        "settings": { "foreground": "{{color14}}" }
      },
      {
        "scope": ["entity.name.function", "support.function", "meta.function-call"],
        "settings": { "foreground": "{{color7}}" }
      },
      {
        "scope": ["variable", "variable.other", "variable.parameter"],
        "settings": { "foreground": "#E0E0E0" }
      },
      {
        "scope": ["constant", "constant.numeric", "constant.language"],
        "settings": { "foreground": "{{color11}}" }
      },
      {
        "scope": ["entity.name.type", "support.type", "support.class"],
        "settings": { "foreground": "{{color13}}" }
      },
      {
        "scope": ["comment", "punctuation.definition.comment"],
        "settings": { "foreground": "{{color8}}", "fontStyle": "italic" }
      }
    ]
  }
}
